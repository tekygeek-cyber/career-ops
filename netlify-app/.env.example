# No new integrations or keys are used on Netlify. Hosted writes are disabled.
# Legacy migration only: retain the original values in the hosting secret store
# until any old encrypted workspace has been exported and its tokens revoked.
# APP_URL=https://your-private-site.netlify.app
# ALLOWED_EMAIL=your-owner-email@example.com
# SESSION_SECRET=original-secret-needed-to-decrypt-existing-records
#
# NEW LOCAL runtime secrets belong in .local-runtime/data/.env (chmod 600),
# created by the local provider prompt. Never copy a real key into this example.
# WORKSPACE_OPENAI_API_KEY='your-own-key'
# WORKSPACE_ANTHROPIC_API_KEY='your-own-key'
# WORKSPACE_GEMINI_API_KEY='your-own-key'
# Gmail refresh token scope must be gmail.metadata only:
# WORKSPACE_GMAIL_CLIENT_ID='your-own-client-id'
# WORKSPACE_GMAIL_CLIENT_SECRET='your-own-client-secret'
# WORKSPACE_GMAIL_REFRESH_TOKEN='your-own-refresh-token'
